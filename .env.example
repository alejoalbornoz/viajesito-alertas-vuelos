# Copiá este archivo a `.env` y completá lo que necesites.
# Lo leen docker compose, el analizador Python y el backend Java (en local).

# --- PostgreSQL --------------------------------------------------------
POSTGRES_DB=viajesito
POSTGRES_USER=viajesito
POSTGRES_PASSWORD=viajesito
POSTGRES_PORT=5432
TZ=America/Argentina/Buenos_Aires

# --- Backend Java ------------------------------------------------------
BACKEND_PORT=8080
# Si lo definís, toda llamada a /api/** debe mandar el header X-Api-Key.
APP_API_KEY=
# Bot de Telegram (ver README). Vacío = modo DRY_RUN: las alertas se loguean pero no se envían.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Anti-spam: no repetir alerta de una ruta dentro de esta ventana...
ALERT_COOLDOWN_HOURS=72
# ...salvo que el precio nuevo sea al menos este % más bajo que el último alertado.
ALERT_MIN_IMPROVEMENT_PCT=3

# --- Analizador Python -------------------------------------------------
# mock = precios simulados (sin API key) | serpapi = Google Flights vía SerpApi
PRICE_PROVIDER=mock
SERPAPI_API_KEY=
# backend = envía las ofertas al backend Java | console = solo las imprime
NOTIFIER=backend
BACKEND_URL=http://localhost:8080
# Alerta si el precio está este % por debajo del promedio histórico
DEAL_THRESHOLD_PCT=15
# Ahorro mínimo vs promedio para que "mínimo histórico" o "anomalía" disparen alerta
MIN_SAVINGS_PCT=5
# Sondeos diarios mínimos antes de usar señales estadísticas
MIN_SAMPLES=5
# Anomalía: precio a N desvíos estándar por debajo de la media
ZSCORE_THRESHOLD=2.0
# Hora diaria de ejecución del modo `schedule` (HH:MM, hora local según TZ)
RUN_AT=08:00
RUN_ON_START=true
